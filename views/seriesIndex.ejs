<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Series - Blogify</title>

    <%- include('./partials/head') %>
</head>

<body>
    <%- include('./partials/nav') %>

        <div class="container my-5">

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
                <div>
                    <h1 class="fw-bold mb-1">Series</h1>
                    <p class="text-muted mb-0">Collections of posts meant to be read in order.</p>
                </div>
                <% if (locals.user) { %>
                    <a href="/series/new" class="btn btn-primary">New Series</a>
                    <% } %>
            </div>

            <% if (allSeries.length === 0) { %>
                <div class="text-center text-muted py-5 border rounded-3">
                    <p class="mb-3">No series yet.</p>
                    <% if (locals.user) { %>
                        <a href="/series/new" class="btn btn-outline-primary">Create the first one</a>
                        <% } else { %>
                            <a href="/user/login" class="btn btn-outline-primary">Log in to create one</a>
                            <% } %>
                </div>
                <% } else { %>
                    <div class="row g-4">
                        <% allSeries.forEach(series=> { %>
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title fw-bold">
                                            <%= series.title %>
                                        </h5>
                                        <p class="card-text text-muted flex-grow-1">
                                            <%= series.description ? series.description : 'No description.' %>
                                        </p>
                                        <div class="d-flex align-items-center justify-content-between mt-3">
                                            <span class="badge text-bg-light border">
                                                <%= countBySeries[series._id.toString()] || 0 %> part<%=
                                                    (countBySeries[series._id.toString()] || 0) === 1 ? '' : 's' %>
                                            </span>
                                            <% if (series.createdBy) { %>
                                                <span class="text-muted small d-inline-flex align-items-center gap-2">
                                                    <img src="<%= series.createdBy.profileImageURL %>" width="24"
                                                        height="24" class="rounded-circle" alt="">
                                                    <%= series.createdBy.userName %>
                                                </span>
                                                <% } %>
                                        </div>
                                        <a href="/series/<%= series.slug %>" class="btn btn-outline-primary mt-3">
                                            View Series
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>

        </div>

        <%- include('./partials/script') %>
</body>

</html>
