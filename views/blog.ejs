<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= blog.title %> - Blogify
    </title>

    <%- include('./partials/head') %>
    <%- include('./partials/prose') %>

    <style>
        /* Series reader rail. Card states mirror assets/series-section-design.png. */
        @media (min-width: 992px) {
            .series-rail {
                position: sticky;
                top: 1rem;
                max-height: calc(100vh - 2rem);
                display: flex;
                flex-direction: column;
            }

            /* Only the list scrolls, so the series header stays pinned above it. */
            .series-rail-list {
                overflow-y: auto;
                flex: 1 1 auto;
                min-height: 0;
            }
        }

        .series-card {
            display: block;
            border: 1px solid #e5e7eb;
            border-radius: .75rem;
            background: #fff;
            padding: .875rem 1rem;
            margin-bottom: .75rem;
            text-decoration: none;
            color: inherit;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        a.series-card:hover {
            border-color: #c7d2fe;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
        }

        .series-card.active {
            border-color: #2563eb;
            background: #f5f8ff;
            box-shadow: 0 0 0 1px #2563eb inset;
        }

        .series-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: .5rem;
        }

        .series-card-part {
            font-size: .75rem;
            font-weight: 600;
            color: #4b5563;
            background: #f3f4f6;
            border-radius: 999px;
            padding: .125rem .5rem;
        }

        .series-card.active .series-card-part {
            color: #1d4ed8;
            background: #e0e7ff;
        }

        .series-card-dot {
            width: .5rem;
            height: .5rem;
            border-radius: 50%;
            background: #2563eb;
        }

        /* Clamp so a long title or body cannot blow out the card height. */
        .series-card-title,
        .series-card-excerpt {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .series-card-title {
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: .25rem;
            -webkit-line-clamp: 2;
        }

        .series-card-excerpt {
            font-size: .875rem;
            color: #6b7280;
            margin-bottom: .5rem;
            -webkit-line-clamp: 2;
        }

        .series-card-meta {
            font-size: .75rem;
            color: #9ca3af;
        }
    </style>
</head>

<body>
    <%- include('./partials/nav') %>

        <% if (locals.series) { %>
            <%
                const prevPost = seriesIndex > 0 ? seriesParts[seriesIndex - 1] : null;
                const nextPost = seriesIndex < seriesParts.length - 1 ? seriesParts[seriesIndex + 1] : null;
                // Cards show prose, not raw Markdown, so headings and emphasis are
                // stripped rather than shown as '#' and '*'.
                const excerpt = (text) => markdownExcerpt(text);
            %>

                <div class="container-fluid px-3 px-lg-4 my-4">
                    <div class="row g-3">

                        <!-- Left rail: every part of the series, in reading order. -->
                        <div class="col-12 col-lg-4 col-xl-3">
                            <div class="series-rail">

                                <div class="series-rail-header mb-3">
                                    <a href="/series/<%= series.slug %>"
                                        class="text-decoration-none text-body fw-bold d-block">
                                        <%= series.title %>
                                    </a>
                                    <span class="text-muted small">
                                        <%= seriesParts.length %> part<%= seriesParts.length === 1 ? '' : 's' %>
                                    </span>
                                </div>

                                <!-- On narrow screens a full list would bury the post, so it collapses. -->
                                <button class="btn btn-outline-secondary btn-sm w-100 mb-3 d-lg-none" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#seriesRailList"
                                    aria-expanded="false" aria-controls="seriesRailList">
                                    <%= series.title %> &middot; Part <%= seriesIndex + 1 %> of <%= seriesParts.length %>
                                </button>

                                <div class="collapse d-lg-block series-rail-list" id="seriesRailList">
                                    <% seriesParts.forEach((part, i) => { %>
                                        <% const isActive = i === seriesIndex; %>
                                            <!-- The current part is not a self-link. -->
                                            <<%= isActive ? 'div' : 'a' %> class="series-card <%= isActive ? 'active' : '' %>"
                                                <% if (!isActive) { %>href="/blog/<%= part._id %>"<% } %>
                                                <% if (isActive) { %>aria-current="page"<% } %>>

                                                <div class="series-card-top">
                                                    <span class="series-card-part">Part <%= i + 1 %></span>
                                                    <% if (isActive) { %>
                                                        <span class="series-card-dot" aria-hidden="true"></span>
                                                        <% } %>
                                                </div>

                                                <div class="series-card-title"><%= part.title %></div>
                                                <div class="series-card-excerpt"><%= excerpt(part.body) %></div>

                                                <div class="series-card-meta">
                                                    <%= new Date(part.createdAt).toLocaleDateString('en-US', {
                                                        year: 'numeric', month: 'short', day: 'numeric' }) %>
                                                </div>
                                            </<%= isActive ? 'div' : 'a' %>>
                                        <% }) %>
                                </div>

                            </div>
                        </div>

                        <!-- Right pane: the post itself. -->
                        <div class="col-12 col-lg-8 col-xl-9">
                            <div class="bg-white border rounded-3 p-3 p-lg-4">

                                <%- include('./partials/postBody') %>

                                    <nav class="d-flex justify-content-between gap-2 mt-5 pt-4 border-top">
                                        <% if (prevPost) { %>
                                            <a href="/blog/<%= prevPost._id %>"
                                                class="btn btn-outline-secondary text-start">
                                                <span class="d-block small text-muted">&larr; Previous</span>
                                                <span><%= prevPost.title %></span>
                                            </a>
                                            <% } else { %>
                                                <span></span>
                                                <% } %>

                                                    <% if (nextPost) { %>
                                                        <a href="/blog/<%= nextPost._id %>"
                                                            class="btn btn-outline-secondary text-end ms-auto">
                                                            <span class="d-block small text-muted">Next &rarr;</span>
                                                            <span><%= nextPost.title %></span>
                                                        </a>
                                                        <% } %>
                                    </nav>

                            </div>
                        </div>

                    </div>
                </div>

                <% } else { %>

                    <div class="container my-5">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <%- include('./partials/postBody') %>
                            </div>
                        </div>
                    </div>

                    <% } %>

        <%- include('./partials/script') %>

            <% if (locals.series) { %>
                <script>
                    // With many parts the active card starts outside the rail's scroll
                    // window. scrollIntoView is not usable here: it walks up every
                    // scrollable ancestor, so it also scrolls the page and still leaves
                    // the card clipped. Set the rail's own scrollTop instead, which
                    // moves nothing else.
                    (function () {
                        var list = document.querySelector('.series-rail-list');
                        var active = document.querySelector('.series-rail-list .series-card.active');
                        if (!list || !active) return;

                        // Only the desktop list is a scroll container; below lg it is a
                        // collapsed accordion and there is nothing to scroll.
                        if (list.scrollHeight <= list.clientHeight) return;

                        var offset = active.offsetTop - list.offsetTop;
                        list.scrollTop = offset - (list.clientHeight - active.offsetHeight) / 2;
                    })();
                </script>
                <% } %>


            <% if (!locals.user) { %>
                <!-- Author card: shown once per session to logged-out visitors who landed here directly -->
                <div class="modal fade" id="authorCardModal" tabindex="-1" aria-labelledby="authorCardModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header border-0 pb-0">
                                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center pt-0">
                                <img src="/favicon.png" alt="Blogify Logo" width="48" height="48" class="mb-3">
                                <h5 class="modal-title fw-bold mb-2" id="authorCardModalLabel">
                                    This is a project by Divyam Jha
                                </h5>
                                <p class="text-muted mb-0">
                                    Blogify is a place to write and share blog posts. Thanks for stopping by!
                                </p>
                            </div>
                            <div class="modal-footer border-0 justify-content-center gap-2">
                                <a href="https://github.com/divyam-jha123" target="_blank" rel="noopener noreferrer"
                                    class="btn btn-dark d-inline-flex align-items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                                        class="bi bi-github" viewBox="0 0 16 16">
                                        <path
                                            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                                    </svg>
                                    GitHub
                                </a>
                                <a href="/" class="btn btn-outline-primary">Browse blogs</a>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    (function () {
                        var STORAGE_KEY = 'blogify:authorCardShown';

                        // Only greet visitors who landed here directly. Clicking through from the
                        // dashboard leaves a same-origin referrer, so those visits are skipped.
                        var referrer = document.referrer;
                        if (referrer) {
                            try {
                                if (new URL(referrer).origin === window.location.origin) return;
                            } catch (err) {
                                // Unparseable referrer: treat it as a direct landing.
                            }
                        }

                        // Show at most once per browser session. sessionStorage can throw in
                        // some privacy modes, in which case we just fall through and show it.
                        try {
                            if (sessionStorage.getItem(STORAGE_KEY)) return;
                            sessionStorage.setItem(STORAGE_KEY, '1');
                        } catch (err) { }

                        document.addEventListener('DOMContentLoaded', function () {
                            var el = document.getElementById('authorCardModal');
                            if (el) new bootstrap.Modal(el).show();
                        });
                    })();
                </script>
                <% } %>
</body>

</html>