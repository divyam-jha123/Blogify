<%
    // Rendered inside either the centered single-column layout (standalone posts)
    // or the right pane of the series reader. `locals.series` decides which.
    const inSeries = Boolean(locals.series);
%>

    <article>

        <% if (blog.coverImageUrl) { %>
            <img src="<%= blog.coverImageUrl %>" class="img-fluid rounded mb-4 w-100" alt="<%= blog.title %>"
                style="max-height: 400px; object-fit: cover;">
            <% } %>

                <% if (inSeries) { %>
                    <a href="/series/<%= series.slug %>"
                        class="d-inline-block text-decoration-none text-primary small fw-semibold mb-2">
                        <%= series.title %>
                    </a>
                    <% } %>

                        <h1 class="display-5 fw-bold mb-3">
                            <%= blog.title %>
                        </h1>

                        <% if (inSeries) { %>
                            <div class="d-flex flex-wrap align-items-center gap-3 text-muted mb-4 pb-3 border-bottom">
                                <span class="d-inline-flex align-items-center">
                                    <%- include('./calendarIcon') %>
                                        <%= new Date(blog.createdAt).toLocaleDateString('en-US', { weekday: 'long' ,
                                            year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                                </span>
                                <span>&middot;</span>
                                <span>Posted By: <%= blog.createdBy.userName %>
                                </span>
                                <span>&middot;</span>
                                <span class="badge text-bg-light border">
                                    Part <%= seriesIndex + 1 %> of <%= seriesParts.length %>
                                </span>
                            </div>
                            <% } else { %>
                                <div class="d-flex flex-column text-muted mb-4 pb-3 border-bottom">
                                    <span class="me-2">
                                        <%- include('./calendarIcon') %>
                                            <%= new Date(blog.createdAt).toLocaleDateString('en-US', { weekday: 'long'
                                                , year: 'numeric' , month: 'long' , day: 'numeric' }) %>
                                    </span>
                                    <br>
                                    <div class="me-2 mb-0">
                                        <p>Posted By: <%= blog.createdBy.userName %>
                                        </p>
                                    </div>
                                </div>
                                <% } %>

                                    <div class="blog-content fs-5 lh-lg">
                                        <%- renderMarkdown(blog.body) %>
                                    </div>

    </article>

    <div class="mt-5 pt-4 border-top">
        <h6 class="text-muted mb-3">Share this post</h6>
        <div class="d-flex gap-2">
            <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(blog.title) %>" target="_blank"
                class="btn btn-outline-primary btn-sm">
                Twitter
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/" target="_blank"
                class="btn btn-outline-primary btn-sm">
                LinkedIn
            </a>
        </div>
    </div>


    <div class="mt-5 text-center">
        <a href="/" class="btn btn-primary">
            &larr; Back to All Blogs
        </a>
    </div>

    <div class="mt-5">
        <h4>Comments (<%= locals.comments ? comments.length : 0 %>)</h4>
        <% if (locals.user) { %>
            <form action="/blog/comment/<%= blog._id %>" method="POST">
                <div class="mb-3">
                    <input type="text" name="content" class="form-control" placeholder="Enter your comment" required />
                    <button class="btn btn-sm btn-primary mt-2" type="submit">Add</button>
                </div>
            </form>
            <% } %>
                <div class="mt-3">
                    <% if (locals.comments) { %>
                        <% comments.forEach(comment=> { %>
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-2">
                                        <img src="<%= comment.createdBy.profileImageURL %>" width="30px"
                                            class="rounded-circle me-2" alt="">
                                        <h6 class="mb-0">
                                            <%= comment.createdBy.userName %>
                                        </h6>
                                    </div>
                                    <p class="mb-0">
                                        <%= comment.content %>
                                    </p>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>
                </div>
    </div>
