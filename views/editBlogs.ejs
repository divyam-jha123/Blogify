<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Post - Blogify</title>

    <%- include('./partials/head') %>
    <%- include('./partials/prose') %>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
          <div class="card shadow-sm border-0">
            <div class="card-body p-4">
              <h4 class="mb-4 text-center">Edit Post</h4>

              <form action="/blog/edit/<%= blog._id %>" method="post" enctype="multipart/form-data">
                <!-- cover image -->

                <% if (blog.coverImageUrl) { %>
                  <div class="mb-3">
                    <img src="<%= blog.coverImageUrl %>" class="img-fluid rounded" alt="<%= blog.title %>"
                      style="max-height: 200px; object-fit: cover;">
                  </div>
                <% } %>

                <div class="mb-3">
                  <label for="cover-image" class="form-label">Cover Image</label>
                  <input
                    name="coverImageUrl"
                    type="file"
                    class="form-control"
                    id="cover-image"
                    placeholder="add image..."
                  />
                  <div class="form-text">Leave empty to keep the current image.</div>
                </div>

                <!-- Title -->
                <div class="mb-3">
                  <label for="title" class="form-label">Title</label>
                  <input
                    type="text"
                    class="form-control"
                    name="title"
                    id="title"
                    placeholder="Enter post title"
                    value="<%= blog.title %>"
                    required
                  />
                </div>

                <!-- Series -->
                <div class="mb-3">
                  <label for="series" class="form-label">Series</label>
                  <select name="series" id="series" class="form-select">
                    <option value="">&mdash; No series &mdash;</option>
                    <% seriesList.forEach(series => { %>
                      <option value="<%= series._id %>" <%= blog.series && blog.series.toString() === series._id.toString() ? 'selected' : '' %>><%= series.title %></option>
                    <% }) %>
                  </select>
                  <div class="form-text">
                    Moving a post to a different series puts it at the end.
                    <a href="/series/new">Create a new series</a>
                  </div>
                </div>

                <!-- Content: Markdown writing canvas -->
                <%- include('./partials/editor', { initialBody: blog.body }) %>

                <!-- Button -->
                <div class="d-grid gap-2">
                  <button type="submit" class="btn btn-primary">
                    Update Post
                  </button>
                  <a href="/blog/<%= blog._id %>" class="btn btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('./partials/script') %>
  </body>
</html>
