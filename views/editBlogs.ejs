<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Post - Blogify</title>

    <%- include('./partials/head') %>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
          <div class="card shadow-sm border-0">
            <div class="card-body p-4">
              <h4 class="mb-4 text-center">Edit Post</h4>

              <form action="/blog/edit/<%= blog._id %>" method="post" enctype="multipart/form-data">
                <!-- cover image -->

                <% if (blog.coverImageUrl) { %>
                  <div class="mb-3">
                    <img src="<%= blog.coverImageUrl %>" class="img-fluid rounded" alt="<%= blog.title %>"
                      style="max-height: 200px; object-fit: cover;">
                  </div>
                <% } %>

                <div class="mb-3">
                  <label for="cover-image" class="form-label">Cover Image</label>
                  <input
                    name="coverImageUrl"
                    type="file"
                    class="form-control"
                    id="cover-image"
                    placeholder="add image..."
                  />
                  <div class="form-text">Leave empty to keep the current image.</div>
                </div>

                <!-- Title -->
                <div class="mb-3">
                  <label for="title" class="form-label">Title</label>
                  <input
                    type="text"
                    class="form-control"
                    name="title"
                    id="title"
                    placeholder="Enter post title"
                    value="<%= blog.title %>"
                    required
                  />
                </div>

                <!-- Content -->
                <div class="form-floating mb-3">
                  <textarea
                    name="content"
                    class="form-control"
                    placeholder="Write your post..."
                    id="floatingTextarea2"
                    style="height: 120px"
                    required
                  ><%= blog.body %></textarea>
                  <label name="body" for="floatingTextarea2">Write content...</label>
                </div>

                <!-- Button -->
                <div class="d-grid gap-2">
                  <button type="submit" class="btn btn-primary">
                    Update Post
                  </button>
                  <a href="/blog/<%= blog._id %>" class="btn btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%- include('./partials/script') %>
  </body>
</html>
